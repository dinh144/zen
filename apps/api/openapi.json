          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "url",
          "domain",
          "note",
          "content",
          "image_path",
          "meta",
          "colors",
          "tags",
          "has_article",
          "pinned_at",
          "seen_at",
          "enriched_at",
          "created_at",
          "updated_at"
