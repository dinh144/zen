{
  "openapi": "3.1.0",
  "info": {
    "title": "zen API",
    "version": "1.0.0"
  },
  "paths": {
    "/cards": {
      "get": {
        "summary": "List Cards",
        "description": "The mind's board, newest first. `after` is the id of the last card already seen: its own\n(created_at, id) is the cursor, so equal timestamps never skip or repeat a card.",
        "operationId": "list_cards_api_cards_get",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "exclusiveMinimum": 0,
              "default": 60,
              "title": "Limit"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardsList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
