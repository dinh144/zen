            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "title": "Url",
            "type": [
              "string",
              "null"
            ]
          },
          "domain": {
            "title": "Domain",
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "title": "Note",
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "title": "Content",
            "type": [
              "string",
              "null"
            ]
          },
          "image_path": {
            "title": "Image Path",
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "additionalProperties": true,
            "propertyNames": {
              "type": "string"
            },
            "type": "object",
            "title": "Meta"
          },
          "colors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Colors"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "has_article": {
            "type": "boolean",
            "title": "Has Article"
          },
          "pinned_at": {
            "title": "Pinned At",
            "type": [
              "string",
              "null"
            ]
          },
          "seen_at": {
            "title": "Seen At",
            "type": [
              "string",
              "null"
            ]
          },
          "enriched_at": {
            "title": "Enriched At",
