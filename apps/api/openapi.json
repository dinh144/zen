            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "quote",
              "link",
              "article",
              "image",
              "video",
              "product",
              "book",
              "movie",
              "recipe",
              "tweet",
              "person",
              "color",
              "font",
              "pdf",
              "file"
            ],
            "title": "Kind"
          },
          "title": {
