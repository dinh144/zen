# Every Supabase CLI stack aliases its db and kong containers to plain "db"/"kong" on its own
# network (checked with `docker inspect`, not assumed), so only the network name needs to change
# between stacks — point SUPABASE_NETWORK at the stack you're running against:
#   supabase_network_zen        the shared local stack (supabase/config.toml, default below)
#   supabase_network_<id>       an agent's own isolated stack, id = that stack's project_id
SUPABASE_NETWORK=supabase_network_zen
PS_DATA_SOURCE_URI=postgres://postgres:postgres@db:5432/postgres
PS_JWKS_URL=http://kong:8000/auth/v1/.well-known/jwks.json
PS_PORT=8090
PS_STORAGE_PASSWORD=postgres
